---
import { getBirthdayCountdowns } from "@/lib/actions"
import { tryCatch } from "@/lib/try-catch"
import { db } from "@/db/client"
import { getCurrentSession } from "@/lib/auth/session"

import BaseLayout from "@/layouts/base.astro"
import EmailLoginForm from "@/components/EmailLoginForm"
import RegisterForm from "@/components/RegisterForm"
import BirthdayBubbleChart from "@/components/BirthdayBubbleChart/BirthdayBubbleChart"
import LogoutButton from "@/components/LogoutButton"

const session = await getCurrentSession(db, Astro.cookies)

const LOGIN_NOTICES: Record<string, string> = {
  expired: "Tu enlace expiró o ya fue usado. Pide uno nuevo.",
  invalid: "El enlace no es válido. Pide uno nuevo.",
}
const loginNotice = LOGIN_NOTICES[Astro.url.searchParams.get("login") ?? ""]

let upcoming: Awaited<ReturnType<typeof getBirthdayCountdowns>> = []
let hasError = false
if (session?.friendId) {
  const result = await tryCatch(getBirthdayCountdowns())
  upcoming = result.error ? [] : result.data
  hasError = result.error !== null
}
---

<BaseLayout>
  <div class="w-full max-w-md space-y-10">
    {
      !session && (
        <>
          <header class="text-center space-y-2">
            <p class="text-4xl">🎂</p>
            <h1 class="text-4xl font-bold text-warm-dark leading-tight">Círculo de cumpleaños</h1>
            <p class="text-warm-muted text-sm max-w-xs mx-auto">
              Ingresa tu correo para unirte al círculo o entrar si ya eres parte.
            </p>
          </header>

          <section class="card">
            <h2 class="text-xl font-bold text-warm-dark mb-5">Entrar</h2>
            <EmailLoginForm initialNotice={loginNotice} client:load />
          </section>
        </>
      )
    }

    {
      session && !session.friendId && (
        <>
          <header class="text-center space-y-2">
            <p class="text-4xl">🎂</p>
            <h1 class="text-4xl font-bold text-warm-dark leading-tight">Ya casi</h1>
            <p class="text-warm-muted text-sm max-w-xs mx-auto">
              Confirmamos tu correo. Cuéntanos tu nombre y fecha de cumpleaños para unirte al círculo.
            </p>
          </header>

          <section class="card">
            <h2 class="text-xl font-bold text-warm-dark mb-5">Unirme al círculo</h2>
            <RegisterForm email={session.email} client:load />
          </section>
        </>
      )
    }

    {
      session && session.friendId && (
        <>
          <header class="text-center space-y-2">
            <p class="text-4xl">🎂</p>
            <h1 class="text-4xl font-bold text-warm-dark leading-tight">Círculo de cumpleaños</h1>
            <p class="text-warm-muted text-sm max-w-xs mx-auto">Así está el círculo hoy.</p>
          </header>

          <section class="space-y-3">
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-bold text-warm-dark">Cumpleaños del círculo</h2>
              <LogoutButton client:load />
            </div>
            <BirthdayBubbleChart countdowns={upcoming} hasError={hasError} client:load />
          </section>
        </>
      )
    }
  </div>
</BaseLayout>
