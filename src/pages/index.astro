---
import { db } from "@/db/client"
import EmailLoginForm from "@/components/EmailLoginForm"
import LogoutButton from "@/components/LogoutButton"
import RegisterForm from "@/components/RegisterForm"
import YearRing from "@/components/YearRing"
import BaseLayout from "@/layouts/base.astro"
import { getCurrentSession } from "@/lib/auth/session"
import { getBirthdayCountdowns } from "@/lib/actions"
import { tryCatch } from "@/lib/try-catch"

const session = await getCurrentSession(db, Astro.cookies)

const LOGIN_NOTICES: Record<string, string> = {
  expired: "Tu enlace expiró o ya fue usado. Pide uno nuevo.",
  invalid: "El enlace no es válido. Pide uno nuevo.",
}
const loginNotice = LOGIN_NOTICES[Astro.url.searchParams.get("login") ?? ""]

let upcoming: Awaited<ReturnType<typeof getBirthdayCountdowns>> = []
let hasError = false
if (session?.friendId) {
  const result = await tryCatch(getBirthdayCountdowns())
  upcoming = result.error ? [] : result.data
  hasError = result.error !== null
}
---

<BaseLayout>
  {
    !session && (
      <div class="w-full space-y-8">
        <header class="space-y-3 text-center">
          <h1 class="text-balance text-3xl font-bold leading-tight tracking-[-0.02em] text-ink">
            Cumpleaños que no se olvidan
          </h1>
          <p class="mx-auto max-w-sm text-pretty text-base text-ink-muted">
            Celebraty reúne las fechas de tu círculo y te avisa cuando llega el día.
          </p>
        </header>
        <YearRing countdowns={[]} client:load />
        <EmailLoginForm initialNotice={loginNotice} client:load />
      </div>
    )
  }

  {
    session && !session.friendId && (
      <div class="w-full space-y-8">
        <header class="space-y-3 text-center">
          <h1 class="text-balance text-3xl font-bold leading-tight tracking-[-0.02em] text-ink">Ya casi</h1>
          <p class="mx-auto max-w-sm text-pretty text-base text-ink-muted">
            Confirmamos tu correo. Añade tu nombre y cumpleaños para unirte al círculo.
          </p>
        </header>
        <YearRing countdowns={[]} client:load />
        <section class="card" aria-label="Registro">
          <RegisterForm email={session.email} client:load />
        </section>
      </div>
    )
  }

  {
    session?.friendId && (
      <div class="w-full space-y-8">
        <header class="space-y-3 text-center">
          <div class="flex items-start justify-between gap-4 text-start">
            <div>
              <h1 class="text-balance text-3xl font-bold leading-tight tracking-[-0.02em] text-ink">
                La vuelta al sol
              </h1>
              <p class="mt-2 text-pretty text-base text-ink-muted">Cumpleaños de tu círculo, en todo el año.</p>
            </div>
            <LogoutButton client:load />
          </div>
        </header>
        <YearRing countdowns={upcoming} hasError={hasError} client:load />
      </div>
    )
  }
</BaseLayout>
